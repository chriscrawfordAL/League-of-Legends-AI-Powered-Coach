# Local development env. Copy to .env and fill in. NEVER commit .env.
# Get a fresh dev key at https://developer.riotgames.com (dev keys expire daily).
RIOT_API_KEY=

# Optional default player (the app sets the analyzed player per-request from its
# Riot ID / Region inputs; leave blank for no default).
TARGET_GAME_NAME=
TARGET_TAG_LINE=
RIOT_PLATFORM=na1
RIOT_REGION=americas
BENCHMARK_TIER=GOLD

# Unity Catalog destination.
UC_CATALOG=main
UC_SCHEMA=league_ai_coach

# Only needed when exercising app/job against a real workspace locally.
DATABRICKS_WAREHOUSE_ID=
SERVING_ENDPOINT=databricks-claude-3-7-sonnet
INGEST_JOB_ID=
